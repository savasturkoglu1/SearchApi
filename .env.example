HOST=127.0.0.1
PORT=3045

# En az 16 karakter kullanın. /health dışındaki tüm route'lar bunu ister.
API_TOKEN=replace-with-a-long-random-token

# patchright | playwright
BROWSER_ENGINE=patchright
# Manuel kullanım için false. Sunucuda smoke/test için true yapılabilir.
BROWSER_HEADLESS=false
# Patchright için kurulu Google Chrome önerilir. Bundled Chromium için boş bırakın.
BROWSER_CHANNEL=chrome
# Her marketin Google cookie/cache durumunu restartlar arasında saklar.
BROWSER_PROFILE_DIR=.browser-profiles
MAX_CONTEXTS=5

CAPTURE_DIR=.api-capiture
CAPTURE_MAX_BODY_BYTES=2097152
# false: authorization/cookie/token benzeri değerler diske yazılmadan maskelenir.
CAPTURE_INCLUDE_SENSITIVE=false
SEARCH_TIMEOUT_MS=90000
